{
  "info": {
    "name": "IELTS Pro API - Session Auth",
    "_postman_id": "ielts-pro-session-2024",
    "description": "API collection dùng Session Cookie (không cần token).\n\n⚠️ QUAN TRỌNG: Bật 'Automatically follow redirects' và đảm bảo Postman lưu cookie.\n\n📌 Postman Settings → Preferences → 'Automatically follow redirects' = ON\n📌 Trong Collection Settings → 'Cookie jar' đang hoạt động\n\n## Thứ tự test\n1. Login (Admin/Teacher/Student)\n2. Courses → Lessons → Tests\n3. Enroll (dùng Student session)\n4. Submit test\n5. Xem Results",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",   "value": "http://localhost:5000/api", "type": "string" },
    { "key": "course_id",  "value": "", "type": "string" },
    { "key": "lesson_id",  "value": "", "type": "string" },
    { "key": "test_id",    "value": "", "type": "string" },
    { "key": "result_id",  "value": "", "type": "string" },
    { "key": "user_id",    "value": "", "type": "string" },
    { "key": "question_id_1", "value": "", "type": "string" },
    { "key": "question_id_2", "value": "", "type": "string" },
    { "key": "question_id_3", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 1. Auth",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Server dang chay', () => pm.expect(pm.response.code).to.eql(200));", "console.log('Session user:', pm.response.json().sessionUser);"], "type": "text/javascript" } }]
        },
        {
          "name": "Login - Admin ⭐ (Chạy đầu tiên)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@ielts.com\",\n  \"password\": \"admin123\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));",
            "const data = pm.response.json();",
            "pm.test('Co user trong response', () => pm.expect(data).to.have.property('user'));",
            "pm.test('Role la admin', () => pm.expect(data.user.role).to.eql('admin'));",
            "pm.test('Khong co token (session-based)', () => pm.expect(data).to.not.have.property('token'));",
            "console.log('Logged in as:', data.user.name, '| Role:', data.user.role);",
            "console.log('Session cookie se duoc luu tu dong boi Postman');"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Login - Teacher ⭐",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"teacher@ielts.com\",\n  \"password\": \"teacher123\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));",
            "pm.test('Role la teacher', () => pm.expect(pm.response.json().user.role).to.eql('teacher'));",
            "console.log('Logged in as teacher:', pm.response.json().user.name);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Login - Student ⭐",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"student@ielts.com\",\n  \"password\": \"student123\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));",
            "pm.test('Role la student', () => pm.expect(pm.response.json().user.role).to.eql('student'));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "GET /me - Xem thong tin session hien tai",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK - Session hop le', () => pm.expect(pm.response.code).to.eql(200));",
            "pm.test('Co user', () => pm.expect(pm.response.json()).to.have.property('user'));",
            "console.log('Current session user:', pm.response.json().user?.name, '|', pm.response.json().user?.role);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "GET /me - Chua login (expect 401)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Cookie", "value": "", "description": "Xoa cookie de test unauthenticated" }],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401 khi chua login', () => pm.expect([200, 401]).to.include(pm.response.code));"], "type": "text/javascript" } }]
        },
        {
          "name": "Login - Sai mat khau (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@ielts.com\",\n  \"password\": \"wrongpassword\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401 sai mat khau', () => pm.expect(pm.response.code).to.eql(401));"] , "type": "text/javascript" } }]
        },
        {
          "name": "Login - Thieu password (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@ielts.com\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 thieu password', () => pm.expect(pm.response.code).to.eql(400));"], "type": "text/javascript" } }]
        },
        {
          "name": "Register - Hoc vien moi",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Nguyen Van Test\",\n  \"email\": \"test_new_student@ielts.com\",\n  \"password\": \"123456\",\n  \"role\": \"student\"\n}" },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 tao tai khoan', () => pm.expect([201, 400]).to.include(pm.response.code));", "console.log(pm.response.json());"], "type": "text/javascript" } }]
        },
        {
          "name": "PUT /profile - Cap nhat ten",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ten Da Cap Nhat\"\n}" },
            "url": { "raw": "{{base_url}}/auth/profile", "host": ["{{base_url}}"], "path": ["auth", "profile"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));"], "type": "text/javascript" } }]
        },
        {
          "name": "POST /logout - Dang xuat",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK logout', () => pm.expect(pm.response.code).to.eql(200));", "console.log('Logged out. Session bi xoa. Can login lai de tiep tuc.');"], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "📚 2. Courses (Login Teacher truoc)",
      "item": [
        {
          "name": "GET /courses - Danh sach",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/courses", "host": ["{{base_url}}"], "path": ["courses"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));",
            "const courses = pm.response.json().courses;",
            "pm.test('Co mang courses', () => pm.expect(courses).to.be.an('array'));",
            "if (courses.length > 0) {",
            "  pm.collectionVariables.set('course_id', courses[0]._id);",
            "  console.log('Saved course_id:', courses[0]._id, '|', courses[0].title);",
            "} else { console.log('Chua co khoa hoc. Chay POST /courses truoc.'); }"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "POST /courses - Tao khoa hoc",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"IELTS Reading Intensive\",\n  \"description\": \"Khoa hoc luyen thi IELTS Reading tu 5.5 len 7.0\",\n  \"level\": \"Intermediate\",\n  \"targetScore\": \"6.5 - 7.0\",\n  \"skills\": [\"Reading\"],\n  \"duration\": 30,\n  \"isPublished\": true\n}" },
            "url": { "raw": "{{base_url}}/courses", "host": ["{{base_url}}"], "path": ["courses"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) {",
            "  pm.collectionVariables.set('course_id', pm.response.json().course._id);",
            "  pm.test('201 Tao thanh cong', () => pm.expect(pm.response.code).to.eql(201));",
            "  console.log('New course_id:', pm.response.json().course._id);",
            "} else { pm.test('Loi - Dam bao login bang teacher/admin', () => pm.expect(pm.response.code).to.eql(201)); console.log(pm.response.json()); }"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "POST /courses - Thieu description (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Khoa hoc thieu description\"\n}" },
            "url": { "raw": "{{base_url}}/courses", "host": ["{{base_url}}"], "path": ["courses"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 validation error', () => pm.expect(pm.response.code).to.eql(400));"], "type": "text/javascript" } }]
        },
        {
          "name": "GET /courses/:id - Chi tiet",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/courses/{{course_id}}", "host": ["{{base_url}}"], "path": ["courses", "{{course_id}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));",
            "const c = pm.response.json().course;",
            "pm.test('Co lessons array', () => pm.expect(c.lessons).to.be.an('array'));",
            "pm.test('Co tests array', () => pm.expect(c.tests).to.be.an('array'));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "PUT /courses/:id - Cap nhat",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"IELTS Reading Intensive - UPDATED\",\n  \"isPublished\": true\n}" },
            "url": { "raw": "{{base_url}}/courses/{{course_id}}", "host": ["{{base_url}}"], "path": ["courses", "{{course_id}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));"], "type": "text/javascript" } }]
        },
        {
          "name": "GET /courses - id sai (expect 400)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/courses/invalid-id", "host": ["{{base_url}}"], "path": ["courses", "invalid-id"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 ObjectId sai', () => pm.expect(pm.response.code).to.eql(400));"], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "🎬 3. Lessons (Login Teacher truoc)",
      "item": [
        {
          "name": "GET /lessons/course/all - Tat ca lesson cua teacher",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/lessons/course/all", "host": ["{{base_url}}"], "path": ["lessons", "course", "all"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));",
            "pm.test('Co mang lessons', () => pm.expect(pm.response.json().lessons).to.be.an('array'));",
            "console.log('Total lessons:', pm.response.json().lessons.length);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "GET /lessons/course/:courseId - Lessons cua 1 khoa hoc",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/lessons/course/{{course_id}}", "host": ["{{base_url}}"], "path": ["lessons", "course", "{{course_id}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));",
            "const lessons = pm.response.json().lessons;",
            "if (lessons.length > 0) { pm.collectionVariables.set('lesson_id', lessons[0]._id); console.log('Saved lesson_id:', lessons[0]._id); }"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "POST /lessons - Tao bai hoc video",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"IELTS Reading - True/False/Not Given\",\n  \"description\": \"Huong dan lam dang bai True False Not Given trong Reading\",\n  \"course\": \"{{course_id}}\",\n  \"type\": \"video\",\n  \"skill\": \"Reading\",\n  \"order\": 1,\n  \"isPublished\": true,\n  \"content\": {\n    \"videoUrl\": \"https://www.youtube.com/embed/dQw4w9WgXcQ\",\n    \"duration\": 25\n  }\n}" },
            "url": { "raw": "{{base_url}}/lessons", "host": ["{{base_url}}"], "path": ["lessons"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) {",
            "  pm.collectionVariables.set('lesson_id', pm.response.json().lesson._id);",
            "  pm.test('201 OK', () => pm.expect(pm.response.code).to.eql(201));",
            "  console.log('lesson_id:', pm.response.json().lesson._id);",
            "} else { console.log('Loi:', pm.response.json()); }"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "POST /lessons - Tao bai hoc document",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"IELTS Reading - Matching Headings\",\n  \"description\": \"Huong dan lam dang bai Matching Headings\",\n  \"course\": \"{{course_id}}\",\n  \"type\": \"document\",\n  \"skill\": \"Reading\",\n  \"order\": 2,\n  \"isPublished\": true,\n  \"content\": {\n    \"text\": \"## Matching Headings\\n\\nDang bai nay yeu cau ban chon tieu de phu hop cho moi doan van.\\n\\n## Chien thuat\\n\\n1. Doc tieu de truoc\\n2. Doc doan van va xac dinh y chinh\\n3. Chon tieu de phu hop nhat\",\n    \"duration\": 20\n  }\n}" },
            "url": { "raw": "{{base_url}}/lessons", "host": ["{{base_url}}"], "path": ["lessons"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 OK', () => pm.expect(pm.response.code).to.eql(201));"], "type": "text/javascript" } }]
        },
        {
          "name": "POST /lessons - Thieu course (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Bai hoc thieu course\"\n}" },
            "url": { "raw": "{{base_url}}/lessons", "host": ["{{base_url}}"], "path": ["lessons"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 validation', () => pm.expect(pm.response.code).to.eql(400));"], "type": "text/javascript" } }]
        },
        {
          "name": "GET /lessons/:id - Chi tiet bai hoc",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/lessons/{{lesson_id}}", "host": ["{{base_url}}"], "path": ["lessons", "{{lesson_id}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));", "pm.test('Co lesson', () => pm.expect(pm.response.json()).to.have.property('lesson'));"], "type": "text/javascript" } }]
        },
        {
          "name": "PUT /lessons/:id - Cap nhat",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"IELTS Reading - True/False/Not Given (Updated)\",\n  \"isPublished\": true\n}" },
            "url": { "raw": "{{base_url}}/lessons/{{lesson_id}}", "host": ["{{base_url}}"], "path": ["lessons", "{{lesson_id}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));"], "type": "text/javascript" } }]
        },
        {
          "name": "GET /lessons/invalid-id (expect 400)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/lessons/not-valid", "host": ["{{base_url}}"], "path": ["lessons", "not-valid"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 ObjectId sai', () => pm.expect(pm.response.code).to.eql(400));"], "type": "text/javascript" } }]
