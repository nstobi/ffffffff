      ]
    },
    {
      "name": "📝 4. Tests (Login Teacher truoc)",
      "item": [
        {
          "name": "GET /tests - Danh sach de thi",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/tests", "host": ["{{base_url}}"], "path": ["tests"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));",
            "const tests = pm.response.json().tests;",
            "pm.test('Co mang tests', () => pm.expect(tests).to.be.an('array'));",
            "if (tests.length > 0) { pm.collectionVariables.set('test_id', tests[0]._id); console.log('Saved test_id:', tests[0]._id, '|', tests[0].title); }"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "POST /tests - Tao de kiem tra",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"IELTS Reading Test - True False Not Given\",\n  \"description\": \"Bai kiem tra dang True/False/Not Given\",\n  \"course\": \"{{course_id}}\",\n  \"skill\": \"Reading\",\n  \"duration\": 20,\n  \"passingScore\": 60,\n  \"isPublished\": true,\n  \"questions\": [\n    {\n      \"question\": \"IELTS Reading Academic co bao nhieu sections?\",\n      \"type\": \"multiple-choice\",\n      \"options\": [\"2\", \"3\", \"4\", \"5\"],\n      \"correctAnswer\": \"3\",\n      \"explanation\": \"IELTS Academic Reading gom 3 passages voi 40 cau hoi trong 60 phut.\",\n      \"points\": 1\n    },\n    {\n      \"question\": \"IELTS Reading co tong cong bao nhieu cau hoi?\",\n      \"type\": \"multiple-choice\",\n      \"options\": [\"30\", \"35\", \"40\", \"45\"],\n      \"correctAnswer\": \"40\",\n      \"explanation\": \"Co 40 cau hoi, moi passage khoang 13-14 cau.\",\n      \"points\": 1\n    },\n    {\n      \"question\": \"True or False: IELTS Reading cho phep su dung tu dien.\",\n      \"type\": \"true-false\",\n      \"options\": [\"True\", \"False\"],\n      \"correctAnswer\": \"False\",\n      \"explanation\": \"Khong duoc su dung tu dien trong ky thi IELTS.\",\n      \"points\": 1\n    }\n  ]\n}" },
            "url": { "raw": "{{base_url}}/tests", "host": ["{{base_url}}"], "path": ["tests"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) {",
            "  const test = pm.response.json().test;",
            "  pm.collectionVariables.set('test_id', test._id);",
            "  pm.collectionVariables.set('question_id_1', test.questions[0]._id);",
            "  pm.collectionVariables.set('question_id_2', test.questions[1]._id);",
            "  pm.collectionVariables.set('question_id_3', test.questions[2]._id);",
            "  pm.test('201 OK', () => pm.expect(pm.response.code).to.eql(201));",
            "  console.log('test_id:', test._id);",
            "  console.log('question_id_1:', test.questions[0]._id);",
            "  console.log('question_id_2:', test.questions[1]._id);",
            "  console.log('question_id_3:', test.questions[2]._id);",
            "  console.log('--- question IDs da duoc luu tu dong vao bien ---');",
            "} else { console.log('Loi:', pm.response.json()); }"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "GET /tests/:id - Chi tiet (Teacher thay dap an)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/tests/{{test_id}}", "host": ["{{base_url}}"], "path": ["tests", "{{test_id}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));",
            "const q = pm.response.json().test.questions;",
            "pm.test('Co questions', () => pm.expect(q).to.be.an('array'));",
            "if (q.length > 0) {",
            "  pm.collectionVariables.set('question_id_1', q[0]._id);",
